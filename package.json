{
  "name": "beatmap-viewer-web",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/server/index.tsx",
    "pack": "node scripts/pack-assets.mjs",
    "build": "node scripts/pack-assets.mjs && vite build && NODE_ENV=production bun build --compile src/server/index.tsx --external=lightningcss --target bun --outfile ./out/server",
    "preview": "./out/server"
  },
  "devDependencies": {
    "@assetpack/core": "^1.7.0",
    "@types/bun": "^1.2.20"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@flatten-js/interval-tree": "2.0.3",
    "@pixi/layout": "^3.1.0",
    "@rian8337/osu-base": "^3.3.0",
    "@soundcut/decode-audio-data-fast": "^2.0.1",
    "@soundtouchjs/audio-worklet": "^1.0.9",
    "@stdlib/array-pool": "^0.3.1",
    "@tailwindcss/vite": "^4.1.12",
    "@tweenjs/tween.js": "^25.0.0",
    "@types/crypto-js": "^4.2.2",
    "@types/d3": "^7.4.3",
    "@zip.js/zip.js": "^2.7.60",
    "bezier-easing": "^2.1.0",
    "crypto-js": "^4.2.0",
    "d3": "^7.9.0",
    "fast-sort": "^3.4.1",
    "js-ini": "^1.6.0",
    "lightningcss": "^1.30.1",
    "node-vibrant": "^4.0.3",
    "osu-classes": "npm:@fukutotojido/osu-classes",
    "osu-parsers": "^4.1.7",
    "osu-standard-stable": "^5.0.1",
    "pixi.js": "^8.17.1",
    "requestidlecallback": "^0.3.0",
    "vite": "^6.3.5",
    "vite-plugin-node-polyfills": "^0.24.0",
    "wavesurfer.js": "^7.12.5",
    "web-demuxer": "^3.0.3"
  }
}
